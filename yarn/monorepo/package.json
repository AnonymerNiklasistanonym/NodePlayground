{
  "name": "mymonorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "dev": "yarn workspace @mymonorepo/webui dev",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
